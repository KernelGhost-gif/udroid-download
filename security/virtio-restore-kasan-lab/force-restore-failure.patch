diff --git a/drivers/virtio/virtio_pci_common.h b/drivers/virtio/virtio_pci_common.h
--- a/drivers/virtio/virtio_pci_common.h
+++ b/drivers/virtio/virtio_pci_common.h
@@ -76,3 +76,6 @@ struct virtio_pci_device {
 	struct virtio_device vdev;
 	struct pci_dev *pci_dev;
+	/* CI-only: count find_vqs calls for failed-restore lifetime tests. */
+	unsigned int ci_test_find_vqs_calls;
+
 	union {
diff --git a/drivers/virtio/virtio_pci_modern.c b/drivers/virtio/virtio_pci_modern.c
--- a/drivers/virtio/virtio_pci_modern.c
+++ b/drivers/virtio/virtio_pci_modern.c
@@ -22,2 +22,4 @@
 #include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
 #include <linux/virtio_pci_admin.h>
@@ -27,1 +29,18 @@
 #include "virtio_pci_common.h"
+
+/*
+ * This boot parameter is used only by the isolated CI KASAN lab.
+ * Allow the initial probe, then fail the next find_vqs() for each device
+ * to drive the driver's restore error path after its queues were frozen.
+ */
+static bool virtio_pci_ci_fail_restore_find_vqs;
+
+static int __init virtio_pci_ci_fail_restore_setup(char *str)
+{
+	if (str && !strcmp(str, "1")) {
+		virtio_pci_ci_fail_restore_find_vqs = true;
+		return 1;
+	}
+	return 0;
+}
+__setup("virtio_pci_ci_fail_restore_find_vqs=",
+	virtio_pci_ci_fail_restore_setup);
@@ -752,1 +770,10 @@
-	int rc = vp_find_vqs(vdev, nvqs, vqs, vqs_info, desc);
+	int rc;
+
+	if (virtio_pci_ci_fail_restore_find_vqs &&
+	    vp_dev->ci_test_find_vqs_calls++) {
+		dev_warn(&vdev->dev,
+			 "VIRTIO_RESTORE_KASAN_TEST_FAIL: injected -ENOMEM from find_vqs\\n");
+		return -ENOMEM;
+	}
+
+	rc = vp_find_vqs(vdev, nvqs, vqs, vqs_info, desc);
