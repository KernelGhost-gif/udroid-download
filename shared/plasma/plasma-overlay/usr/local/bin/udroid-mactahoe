#!/bin/sh
set -eu

if command -v kwriteconfig6 >/dev/null 2>&1; then
    kde_config_tool=kwriteconfig6
elif command -v kwriteconfig5 >/dev/null 2>&1; then
    kde_config_tool=kwriteconfig5
else
    echo "Neither "$kde_config_tool" nor kwriteconfig5 is installed" >&2
    exit 1
fi

config_home=${XDG_CONFIG_HOME:-$HOME/.config}

install -d "$config_home/Kvantum" "$config_home/gtk-3.0" "$config_home/gtk-4.0"

cat > "$config_home/Kvantum/kvantum.kvconfig" <<'EOF'
[General]
theme=MacTahoeOpaque
EOF

cat > "$config_home/gtk-3.0/settings.ini" <<'EOF'
[Settings]
gtk-theme-name=MacTahoe-Dark-solid
gtk-icon-theme-name=MacTahoe-dark
gtk-font-name=Inter 10
gtk-cursor-theme-name=MacTahoe-dark
gtk-cursor-theme-size=24
gtk-decoration-layout=close,minimize,maximize:menu
EOF

cp "$config_home/gtk-3.0/settings.ini" "$config_home/gtk-4.0/settings.ini"

"$kde_config_tool" --file kdeglobals --group General --key ColorScheme MacTahoeDark
"$kde_config_tool" --file kdeglobals --group General --key font 'Inter,10,-1,5,50,0,0,0,0,0'
"$kde_config_tool" --file kdeglobals --group General --key fixed 'JetBrains Mono,10,-1,5,50,0,0,0,0,0'
"$kde_config_tool" --file kdeglobals --group Icons --key Theme MacTahoe-dark
"$kde_config_tool" --file kdeglobals --group KDE --key widgetStyle kvantum-dark
"$kde_config_tool" --file kcminputrc --group Mouse --key cursorTheme MacTahoe-dark
"$kde_config_tool" --file kcminputrc --group Mouse --key cursorSize 24
"$kde_config_tool" --file konsolerc --group 'Desktop Entry' --key DefaultProfile uDroid.profile

"$kde_config_tool" --file kwinrc --group org.kde.kdecoration2 --key BorderSize Tiny
"$kde_config_tool" --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft XAI
"$kde_config_tool" --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnRight ''
"$kde_config_tool" --file kwinrc --group org.kde.kdecoration2 --key library org.kde.kwin.aurorae.v2
"$kde_config_tool" --file kwinrc --group org.kde.kdecoration2 --key theme __aurorae__svg__MacTahoe-Dark

# Retain rounded masks and shadows, but avoid expensive full-surface blending.
"$kde_config_tool" --file kwinrc --group Compositing --key Enabled true
"$kde_config_tool" --file kwinrc --group Plugins --key blurEnabled false
"$kde_config_tool" --file kwinrc --group Plugins --key backgroundcontrastEnabled false
"$kde_config_tool" --file kwinrc --group Plugins --key translucencyEnabled false

"$kde_config_tool" --file kscreenlockerrc --group Daemon --key Autolock false
"$kde_config_tool" --file kscreenlockerrc --group Daemon --key LockOnResume false
"$kde_config_tool" --file kglobalshortcutsrc --group krunner --key _launch \
    'Meta+Space,Alt+F2,Run Command'

if command -v plasma-apply-lookandfeel >/dev/null 2>&1; then
    plasma-apply-lookandfeel --apply com.github.vinceliuice.MacTahoe-Dark \
        --resetLayout
else
    lookandfeeltool -a com.github.vinceliuice.MacTahoe-Dark
fi

if command -v plasma-apply-desktoptheme >/dev/null 2>&1; then
    plasma-apply-desktoptheme MacTahoe-Dark-Opaque
else
    "$kde_config_tool" --file plasmarc --group Theme --key name MacTahoe-Dark-Opaque
fi

if command -v qdbus6 >/dev/null 2>&1; then
    qdbus_tool=qdbus6
elif command -v qdbus >/dev/null 2>&1; then
    qdbus_tool=qdbus
else
    qdbus_tool=
fi

if [ -n "$qdbus_tool" ]; then
    "$qdbus_tool" org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
fi
